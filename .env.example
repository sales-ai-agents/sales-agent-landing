# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# API Base URL
NEXT_PUBLIC_API_URL=https://api.calls4u.ai
# Secret for /internal/revalidate and /internal/indexnow (server-only, must match the backend)
BLOG_REVALIDATE_SECRET=change-me

# OAuth Providers
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
NEXT_PUBLIC_GITHUB_REDIRECT_URI=https://yourdomain.com/auth/github/callback

# Google Picker
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=your-google-api-key
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=your-project-number
